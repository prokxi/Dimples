{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"ask": [
			"Edit(pom.xml)",
			"Edit(compose.yaml)",
			"Edit(.mvn/**)",
			"Edit(**/SecurityConfig*.java)",
			"Edit(**/*ArchitectureTest.java)",
			"Edit(**/archunit.properties)",
			"Edit(.claude/**)",
			"Edit(.gitlint)",
			"Edit(.githooks/**)",
			"Edit(AGENTS.md)"
		],
		"deny": [
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git push origin main:*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-file-edit.sh\""
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.sh\"",
						"timeout": 300
					}
				]
			}
		]
	}
}
